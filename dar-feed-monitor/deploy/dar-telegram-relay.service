[Unit]
Description=DAR Telegram subscriptions and latest report
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dar-relay
Group=dar-relay
WorkingDirectory=/var/lib/dar-telegram-relay
EnvironmentFile=/etc/dar-telegram-relay.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/dar-feed-monitor/deploy/relay.py
StateDirectory=dar-telegram-relay
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
